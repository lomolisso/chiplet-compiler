{
  "$defs": {
    "Check": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CheckStatus"
        }
      },
      "required": [
        "name",
        "status",
        "evidence"
      ],
      "type": "object"
    },
    "CheckStatus": {
      "enum": [
        "pass",
        "fail",
        "skip"
      ],
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "What a check looked at: certificate and log paths, counts, free-form notes.",
      "properties": {
        "counts": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "default": {},
          "type": "object"
        },
        "notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "paths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/Check"
      },
      "type": "array"
    },
    "pass": {
      "type": "string"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "pass",
    "checks"
  ],
  "title": "VerifyReport",
  "type": "object"
}
