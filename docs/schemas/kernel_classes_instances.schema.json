        {
          "const": "finite_nan",
          "description": "`FN`: finite, NaN only, no infinities (OCP OFP8 E4M3, MLIR `f8E4M3FN`).",
          "type": "string"
        },
        {
          "const": "finite_nan_unsigned_zero",
          "description": "`FNUZ`: finite, one NaN encoding (negative zero), no infinities (MLIR `f8E4M3FNUZ`, `f8E5M2FNUZ`).",
          "type": "string"
