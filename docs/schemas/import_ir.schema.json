          "$ref": "#/$defs/Owner"
        }
      },
      "required": [
        "owner",
        "args",
        "ops"
      ],
      "type": "object"
    },
    "RegionId": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "Rel": {
      "enum": [
        "Ge",
        "Le",
        "Eq"
      ],
      "type": "string"
    },
    "Scalar": {
      "description": "One element of a dense constant.",
