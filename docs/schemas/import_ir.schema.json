        },
        "prov": {
          "$ref": "#/$defs/Provenance"
        },
        "regions": {
          "items": {
            "$ref": "#/$defs/RegionId"
          },
          "type": "array"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/ValueId"
          },
          "type": "array"
        },
        "size": {
          "description": "Size computation (design §4.2): the op computes dimension values that reach a shape operand or a\nshape assertion.",
          "type": "boolean"
        },
        "target": {
          "description": "`call_target_name` of a `stablehlo.custom_call`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "operands",
        "results",
        "attrs",
        "regions",
        "parent",
        "size",
        "dim_as_data",
        "prov"
      ],
      "type": "object"
    },
    "OpId": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "Owner": {
      "description": "What owns a region.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "func": {
              "$ref": "#/$defs/FuncId"
