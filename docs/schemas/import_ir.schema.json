      "description": "Why a function survives inlining.",
      "oneOf": [
        {
          "const": "entry",
          "description": "The phase entry (`main`).",
          "type": "string"
        },
        {
          "const": "decomposition",
          "description": "The decomposition of a component composite (`cc.*`).",
          "type": "string"
        },
        {
          "const": "computation",
          "description": "A computation referenced by a `custom_call` (`called_computations`, e.g. a reducer).",
          "type": "string"
        }
      ]
    },
