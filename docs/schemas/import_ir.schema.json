        "loc": {
          "description": "Index into `Module::locs`.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "op": {
          "description": "Op id in `graph.json`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "func",
        "op",
        "loc",
        "inlined_from"
      ],
      "type": "object"
    },
    "Region": {
      "properties": {
        "args": {
          "items": {
            "$ref": "#/$defs/ValueId"
          },
          "type": "array"
        },
        "ops": {
          "description": "In program order; the last op is the terminator (`func.return` / `stablehlo.return`).",
