      "description": "An element type. MLIR signless `iN` (N > 1) is a signed two's-complement integer in StableHLO\n(spec \"Types\": `si`/`i` are signed, `ui` unsigned); `i1` is the boolean.",
      "oneOf": [
        {
          "enum": [
            "bool"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "int": {
              "properties": {
                "signed": {
                  "type": "boolean"
                },
                "width": {
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "signed",
                "width"
              ],
              "type": "object"
            }
          },
          "required": [
            "int"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "float": {
              "properties": {
                "exp": {
                  "format": "uint8",
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                "flavour": {
                  "$ref": "#/$defs/FloatFlavour"
                },
                "mant": {
                  "format": "uint8",
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "exp",
                "mant",
                "flavour"
              ],
              "type": "object"
            }
          },
          "required": [
            "float"
