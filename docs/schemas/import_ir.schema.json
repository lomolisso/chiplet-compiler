        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "$ref": "#/$defs/Atom"
          },
          {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        ],
        "type": "array"
      },
      "type": "array"
    },
    "Op": {
      "properties": {
        "attrs": {
          "additionalProperties": {
            "$ref": "#/$defs/Attr"
          },
          "type": "object"
        },
        "callee": {
          "anyOf": [
            {
              "$ref": "#/$defs/FuncId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The decomposition of a composite, or the computation of a custom call."
        },
        "dim_as_data": {
          "description": "Operand ports where a dimension value enters compute (a size value at a non-shape port of a\nnon-size op), ascending.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "name": {
          "description": "`stablehlo.add`, `func.return`, …",
          "type": "string"
        },
        "operands": {
          "items": {
            "$ref": "#/$defs/ValueId"
          },
          "type": "array"
        },
        "parent": {
          "$ref": "#/$defs/RegionId",
