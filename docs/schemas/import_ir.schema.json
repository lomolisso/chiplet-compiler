      "description": "`stablehlo.gather` dimension numbers (spec `#gather`).",
      "properties": {
        "collapsed_slice_dims": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "index_vector_dim": {
          "format": "int64",
          "type": "integer"
        },
        "offset_dims": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "operand_batching_dims": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "start_index_map": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
