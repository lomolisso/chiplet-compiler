{
  "$defs": {
    "CoverageEntry": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "rows": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/Status"
        }
      },
      "required": [
        "key",
        "status",
        "rows"
      ],
      "type": "object"
    },
    "Status": {
      "description": "What a primitive has.",
      "oneOf": [
        {
          "enum": [
            "measured"
          ],
          "type": "string"
        },
        {
          "const": "provisional",
          "description": "Measured on stand-in RTL (the requantization primitive with its float conversion).",
          "type": "string"
        },
        {
          "const": "pending",
          "description": "No RTL: a float op without a route (a gap) or excluded, with the reason.",
          "type": "string"
        },
        {
          "const": "core",
          "description": "An IP core's RTL (or its adapter) that float primitives instantiate: no rows of its own.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`coverage.json`.",
  "properties": {
    "primitives": {
      "items": {
        "$ref": "#/$defs/CoverageEntry"
      },
      "type": "array"
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "primitives"
  ],
  "title": "Coverage",
  "type": "object"
}
