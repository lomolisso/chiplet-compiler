        {
          "additionalProperties": false,
          "properties": {
            "min": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/SymExpr"
                },
                {
                  "$ref": "#/$defs/SymExpr"
                }
              ],
              "type": "array"
            }
          },
          "required": [
            "min"
          ],
