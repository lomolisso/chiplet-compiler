          },
          "required": [
            "mod"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "max": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/SymExpr"
                },
                {
                  "$ref": "#/$defs/SymExpr"
                }
              ],
              "type": "array"
            }
          },
          "required": [
            "max"
