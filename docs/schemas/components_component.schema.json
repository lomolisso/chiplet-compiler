{
  "$defs": {
    "AAttr": {
      "description": "An abstract attribute.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Kept as is (axis numbers, dimension numbers, enums, …).",
          "properties": {
            "lit": {
              "$ref": "#/$defs/Attr"
            }
          },
          "required": [
            "lit"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A size attribute: `Some(v)` entries are the literals 0 and 1, `None` entries are parameters.",
          "properties": {
            "sized": {
              "properties": {
                "entries": {
                  "items": {
                    "format": "int64",
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "type": "array"
                },
                "form": {
                  "$ref": "#/$defs/SizedForm"
                }
              },
              "required": [
                "form",
                "entries"
              ],
              "type": "object"
            }
          },
          "required": [
            "sized"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A constant's value: a parameter (`splat` stays).",
          "properties": {
            "value": {
              "properties": {
                "splat": {
                  "type": "boolean"
                }
              },
              "required": [
                "splat"
              ],
              "type": "object"
            }
          },
          "required": [
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "ADim": {
      "description": "An abstract dim: the literal 1, or a class variable.",
      "oneOf": [
        {
          "enum": [
            "one"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "var": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "var"
          ],
          "type": "object"
        }
      ]
    },
    "ANode": {
      "description": "A node of an abstract graph.",
      "properties": {
        "attrs": {
          "additionalProperties": {
            "$ref": "#/$defs/AAttr"
          },
          "type": "object"
        },
        "child": {
          "description": "The child component of a composite call (filled by deduplication).",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/AType"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "attrs",
        "results"
      ],
      "type": "object"
    },
    "AType": {
      "description": "An abstract tensor type: family, element class, dims.",
      "properties": {
        "dims": {
          "items": {
            "$ref": "#/$defs/ADim"
          },
          "type": "array"
        },
        "elem": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "family": {
          "$ref": "#/$defs/Family"
        }
      },
      "required": [
        "family",
        "elem",
        "dims"
      ],
      "type": "object"
    },
