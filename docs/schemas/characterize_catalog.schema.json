{
  "$defs": {
    "Generator": {
      "description": "A generator run in the toolchain image's RTL step (docs/passes/characterize.md §4.2). The module or\nentity it writes is named after the primitive that holds it; the arguments never name it.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Our HardFloat generator (`hardfloat-gen <args> --module <id> --out <id>.v`): Berkeley HardFloat's\nChisel cores behind an IEEE interface, lowered to Verilog by firtool.",
          "properties": {
            "args": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "tool": {
              "const": "hardfloat",
              "type": "string"
            }
          },
          "required": [
            "tool",
            "args"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "FloPoCo (`flopoco <args> name=<id> outputFile=<id>.vhdl`): VHDL, read by Yosys through GHDL.",
          "properties": {
            "args": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "tool": {
              "const": "flopoco",
              "type": "string"
            }
          },
          "required": [
            "tool",
            "args"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A function of an XLS DSLX library under `$XLS_DSLX_PATH` (`file` relative to it, function `top`),\nconverted to combinational Verilog like the catalog's DSLX.",
          "properties": {
            "file": {
              "type": "string"
            },
            "tool": {
              "const": "xls_dslx",
              "type": "string"
            },
            "top": {
              "type": "string"
            }
          },
          "required": [
            "tool",
            "file",
            "top"
          ],
          "type": "object"
        }
      ]
    },
    "Kind": {
      "oneOf": [
        {
          "const": "op",
          "description": "One element-wise op at one type (or type pair, for `convert`).",
          "type": "string"
        },
        {
          "const": "mux",
          "description": "An N-input multiplexer with a binary select.",
          "type": "string"
        },
        {
          "const": "register",
          "description": "A register (D flip-flops, no reset).",
          "type": "string"
        },
        {
          "const": "accumulator",
          "description": "A commutative combiner with its result register in the feedback loop.",
          "type": "string"
        },
        {
          "const": "split",
          "description": "A wrapping w-bit multiply composed of n-bit unsigned piece multipliers and a shift-add tree.",
          "type": "string"
        },
        {
          "const": "rescale",
          "description": "The fixed-point requantization primitive (`cc_smt::ops::rescale`): an integer times an f32 scale\nby an exact integer multiply and a rounding shift, back to f32.",
          "type": "string"
        },
        {
          "const": "core",
          "description": "The RTL of an IP core (generated in the RTL step) or of the adapter around one, which float\nprimitives instantiate; not a design of its own (no rows).",
          "type": "string"
        }
      ]
    },
    "Primitive": {
      "additionalProperties": false,
      "description": "One primitive.",
      "properties": {
        "clocked": {
          "description": "The design has a `clk` port.",
          "type": "boolean"
        },
        "deps": {
          "description": "Ids of primitives whose RTL this one instantiates (their RTL files, and their dependencies', are\nread with it).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "family": {
          "description": "`bool`, `sint`, `uint`, `float`, or `bits` for structural primitives.",
          "type": "string"
        },
        "id": {
          "description": "The Verilog module and file stem.",
          "type": "string"
        },
        "key": {
          "description": "Stable key: `<op>[.<variant>]@<type>[><type>]`, e.g. `add@i32`, `compare.LT@ui8`,\n`convert@f32>bf16`, `mux4@w8`, `register@w8`, `accumulator.add@i32`, `split@w32n8`,\n`rescale@i32`.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "libraries": {
          "description": "Vendor libraries the RTL instantiates cells of (`designware`); a flow must link them.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "op": {
          "type": "string"
        },
        "pending": {
          "description": "Why there is no RTL yet (no rows are measured).",
          "type": [
            "string",
            "null"
          ]
        },
        "provisional": {
          "description": "The RTL is a stand-in for what the primitive will be (the requantization primitive's float\nconversion as characterized); no float op is provisional any more.",
          "type": "boolean"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ]
        },
        "types": {
          "description": "Operand type names (`i32`, `ui8`, `i1`, `f32`, …; `w<n>` for bit vectors); for `convert` the source\nthen the target.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "variant": {
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "description": "The width that trends are taken over: result bits (the source width for `convert`; the input\ncount `n` of a mux is part of its op name).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "key",
        "id",
        "kind",
        "op",
        "family",
        "types",
        "width",
        "provisional",
        "deps",
        "clocked"
      ],
      "type": "object"
    },
    "Source": {
      "description": "The RTL of a primitive.",
      "oneOf": [
        {
          "description": "A DSLX module; `ir_converter_main` → `opt_main` → `codegen_main` make `rtl/<id>.v`.",
          "properties": {
            "lang": {
              "const": "dslx",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "lang",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "Verilog written as is to `rtl/<id>.v`.",
          "properties": {
            "lang": {
              "const": "verilog",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "lang",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "VHDL written as is to `rtl/<id>.vhdl` (Yosys reads it through GHDL).",
          "properties": {
            "lang": {
              "const": "vhdl",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "lang",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "RTL a generator of the toolchain image writes in the RTL step (an IP core: HardFloat, FloPoCo, an\nXLS DSLX library function), `rtl/<id>.v` or `rtl/<id>.vhdl`, its module or entity named `<id>`.",
          "properties": {
            "lang": {
              "const": "generated",
              "type": "string"
            },
            "text": {
              "$ref": "#/$defs/Generator"
            }
          },
          "required": [
            "lang",
            "text"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "items": {
    "$ref": "#/$defs/Primitive"
  },
  "title": "Array_of_Primitive",
  "type": "array"
}
