{
  "$defs": {
    "Route": {
      "additionalProperties": false,
      "description": "The route of one catalog primitive.",
      "properties": {
        "bound_ulp": {
          "description": "The route's error bound in ulps of the op's format, when the contracts give one.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "budget_ulp": {
          "description": "The op's budget in ulps (`[numerics]`; 0: correctly rounded).",
          "format": "double",
          "type": "number"
        },
        "cores": {
          "items": {
            "$ref": "#/$defs/RouteCore"
          },
          "type": "array"
        },
        "glue": {
          "description": "The `cc_float` glue module of the wrapper (`glue_<op>_<format>...`), when there is one.",
          "type": [
            "string",
            "null"
          ]
        },
        "k": {
          "description": "Extra significand bits of a composition's inner cores (`q = p + k`).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "key": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RouteKind"
        },
        "note": {
          "type": "string"
        },
        "op": {
          "type": "string"
        },
        "recipe": {
          "description": "What is built around or from the cores.",
          "type": [
            "string",
            "null"
          ]
        },
        "types": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "within_budget": {
          "description": "Whether the bound is within the budget (absent: no bound to compare).",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "key",
        "op",
        "types",
        "kind",
        "cores",
        "budget_ulp",
        "note"
      ],
      "type": "object"
    },
    "RouteCore": {
      "additionalProperties": false,
      "description": "One core of a route.",
      "properties": {
        "accuracy": {
          "description": "The contract's accuracy: `correctly_rounded`, `faithful`, `<n> ulp`, `absolute <bound>`,\n`unbounded`; its subnormal mode (`ieee`, `flush`) and whether it has the IEEE special values.",
          "type": "string"
        },
        "format": {
          "description": "The format the provider was asked at (its operands'): a format name (`f32`, `f16`, `bf16`,\n`f8e5m2`) or `e<E>m<M>`.",
          "type": "string"
        },
        "ieee_specials": {
          "type": "boolean"
        },
        "module": {
          "type": "string"
        },
        "op": {
          "description": "The core operation (`cc_core::adapters::CoreOp` syntax).",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "The instance's parameters (Verilog literals).",
          "type": "object"
        },
        "provider": {
          "type": "string"
        },
        "source": {
          "description": "Where the RTL comes from: `designware` (the vendor library), `hardfloat`, `flopoco`, `xls_dslx`.",
          "type": "string"
        },
        "subnormals": {
          "type": "string"
        },
        "timing": {
          "description": "`combinational` (every core of a route is).",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "op",
        "format",
        "module",
        "params",
        "accuracy",
        "subnormals",
        "ieee_specials",
        "source",
        "timing"
      ],
      "type": "object"
    },
    "RouteKind": {
      "description": "What a route is built from.",
      "oneOf": [
        {
          "const": "core",
          "description": "One wrapper around one or two cores.",
          "type": "string"
        },
        {
          "const": "composition",
          "description": "A composition of cores (`cc_float::recipe`; rounding to integral through two cores).",
          "type": "string"
        },
        {
          "const": "glue",
          "description": "Bit-level glue only.",
          "type": "string"
        },
        {
          "const": "excluded",
          "description": "Deliberately without a primitive (float `remainder`: constant computation only).",
          "type": "string"
        },
        {
          "const": "gap",
          "description": "No provider of the flow offers what the op needs.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`out/library/routes.json`.",
  "properties": {
    "flow": {
      "description": "The synthesis flow and its providers, in order.",
      "type": "string"
    },
    "gaps": {
      "description": "Keys of the routes that are gaps.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "providers": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/Route"
      },
      "type": "array"
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "flow",
    "providers",
    "routes",
    "gaps"
  ],
  "title": "Routes",
  "type": "object"
}
