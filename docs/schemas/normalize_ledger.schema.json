{
  "$defs": {
    "AAttr": {
      "description": "An abstract attribute.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Kept as is (axis numbers, dimension numbers, enums, …).",
          "properties": {
            "lit": {
              "$ref": "#/$defs/Attr"
            }
          },
          "required": [
            "lit"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A size attribute: `Some(v)` entries are the literals 0 and 1, `None` entries are parameters.",
          "properties": {
            "sized": {
              "properties": {
                "entries": {
                  "items": {
                    "format": "int64",
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "type": "array"
                },
                "form": {
                  "$ref": "#/$defs/SizedForm"
                }
              },
              "required": [
                "form",
                "entries"
              ],
              "type": "object"
            }
          },
          "required": [
            "sized"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A constant's value: a parameter (`splat` stays).",
          "properties": {
            "value": {
              "properties": {
                "splat": {
                  "type": "boolean"
                }
              },
              "required": [
                "splat"
              ],
              "type": "object"
            }
          },
          "required": [
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "ADim": {
      "description": "An abstract dim: the literal 1, or a class variable.",
      "oneOf": [
        {
          "enum": [
            "one"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "var": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "var"
          ],
          "type": "object"
        }
      ]
    },
    "ANode": {
      "description": "A node of an abstract graph.",
      "properties": {
        "attrs": {
          "additionalProperties": {
            "$ref": "#/$defs/AAttr"
          },
          "type": "object"
        },
        "child": {
          "description": "The child component of a composite call (filled by deduplication).",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/AType"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "attrs",
        "results"
      ],
      "type": "object"
    },
    "AType": {
      "description": "An abstract tensor type: family, element class, dims.",
      "properties": {
        "dims": {
          "items": {
            "$ref": "#/$defs/ADim"
          },
          "type": "array"
        },
        "elem": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "family": {
          "$ref": "#/$defs/Family"
        }
      },
      "required": [
        "family",
        "elem",
        "dims"
      ],
      "type": "object"
    },
    "Atom": {
      "description": "An atom of a monomial.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "var": {
              "type": "string"
            }
          },
          "required": [
            "var"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "floor_div": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/SymExpr"
                },
                {
                  "$ref": "#/$defs/SymExpr"
                }
              ],
              "type": "array"
            }
          },
          "required": [
            "floor_div"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "mod": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/SymExpr"
                },
                {
                  "$ref": "#/$defs/SymExpr"
                }
              ],
              "type": "array"
            }
          },
          "required": [
            "mod"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "max": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/SymExpr"
                },
                {
                  "$ref": "#/$defs/SymExpr"
                }
              ],
              "type": "array"
            }
          },
          "required": [
            "max"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "min": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/SymExpr"
                },
                {
                  "$ref": "#/$defs/SymExpr"
                }
              ],
              "type": "array"
            }
          },
          "required": [
            "min"
          ],
          "type": "object"
        }
      ]
    },
    "Attr": {
      "description": "A typed attribute.",
      "oneOf": [
        {
          "enum": [
            "unit"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "int": {
              "properties": {
                "ty": {
                  "type": "string"
                },
                "value": {
                  "format": "int128",
                  "type": "integer"
                }
              },
              "required": [
                "value",
                "ty"
              ],
              "type": "object"
            }
          },
          "required": [
            "int"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "float": {
              "properties": {
                "ty": {
                  "type": "string"
                },
                "value": {
                  "$ref": "#/$defs/Scalar"
                }
              },
              "required": [
                "value",
                "ty"
              ],
              "type": "object"
            }
          },
          "required": [
            "float"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "bool": {
              "type": "boolean"
            }
          },
          "required": [
            "bool"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "str": {
              "type": "string"
            }
          },
          "required": [
            "str"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "symbol": {
              "type": "string"
            }
          },
          "required": [
            "symbol"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "ints": {
              "items": {
                "format": "int64",
                "type": "integer"
              },
              "type": "array"
            }
          },
          "required": [
            "ints"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "bools": {
              "items": {
                "type": "boolean"
              },
              "type": "array"
            }
          },
          "required": [
            "bools"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Dense elements: the values when the export kept them (at most 1024), else a content digest.",
          "properties": {
            "dense": {
              "properties": {
                "digest": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "splat": {
                  "type": "boolean"
                },
                "ty": {
                  "$ref": "#/$defs/Type"
                },
                "values": {
                  "items": {
                    "$ref": "#/$defs/Scalar"
                  },
                  "type": [
                    "array",
                    "null"
                  ]
                }
              },
              "required": [
                "ty",
                "splat"
              ],
              "type": "object"
            }
          },
          "required": [
            "dense"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "array": {
              "items": {
                "$ref": "#/$defs/Attr"
              },
              "type": "array"
            }
          },
          "required": [
            "array"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "dict": {
              "additionalProperties": {
                "$ref": "#/$defs/Attr"
              },
              "type": "object"
            }
          },
          "required": [
            "dict"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "$ref": "#/$defs/Type"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A StableHLO enum (`comparison_direction`, `comparison_type`, `fft_type`, `precision`, …).",
          "properties": {
            "enum": {
              "properties": {
                "kind": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "type": "object"
            }
          },
          "required": [
            "enum"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "dot_dims": {
              "$ref": "#/$defs/DotDims"
            }
          },
          "required": [
            "dot_dims"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "conv_dims": {
              "$ref": "#/$defs/ConvDims"
            }
          },
          "required": [
            "conv_dims"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "gather_dims": {
              "$ref": "#/$defs/GatherDims"
            }
          },
          "required": [
            "gather_dims"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "scatter_dims": {
              "$ref": "#/$defs/ScatterDims"
            }
          },
          "required": [
            "scatter_dims"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "No structured form: the printed attribute.",
          "properties": {
            "opaque": {
              "type": "string"
            }
          },
          "required": [
            "opaque"
          ],
          "type": "object"
        }
      ]
    },
    "ConvDims": {
      "description": "`stablehlo.convolution` dimension numbers (spec `#convolution`).",
      "properties": {
        "input_batch": {
          "format": "int64",
          "type": "integer"
        },
        "input_feature": {
          "format": "int64",
          "type": "integer"
        },
        "input_spatial": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "kernel_input_feature": {
          "format": "int64",
          "type": "integer"
        },
        "kernel_output_feature": {
          "format": "int64",
          "type": "integer"
        },
        "kernel_spatial": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "output_batch": {
          "format": "int64",
          "type": "integer"
        },
        "output_feature": {
          "format": "int64",
          "type": "integer"
        },
        "output_spatial": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "input_batch",
        "input_feature",
        "input_spatial",
        "kernel_input_feature",
        "kernel_output_feature",
        "kernel_spatial",
        "output_batch",
        "output_feature",
        "output_spatial"
      ],
      "type": "object"
    },
    "Dim": {
      "description": "A dimension: a constant or a symbolic expression over the model's size symbols. A `Sym` is never a\nconstant expression (constructors fold it into `Const`).",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "const": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "const"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "sym": {
              "$ref": "#/$defs/SymExpr"
            }
          },
          "required": [
            "sym"
          ],
          "type": "object"
        }
      ]
    },
    "DotDims": {
      "description": "`stablehlo.dot_general` dimension numbers (spec `#dot_general`).",
      "properties": {
        "lhs_batching": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "lhs_contracting": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "rhs_batching": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "rhs_contracting": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "lhs_batching",
        "rhs_batching",
        "lhs_contracting",
        "rhs_contracting"
      ],
      "type": "object"
    },
    "EdgeEnd": {
      "properties": {
        "port": {
          "$ref": "#/$defs/PortLabel"
        },
        "res": {
          "description": "Result index of the source.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "res",
        "port"
      ],
      "type": "object"
    },
    "Edit": {
      "description": "One edit of the working graph. Node ids are the input component's.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Remove one edge end `src -> dst`.",
          "properties": {
            "unlink": {
              "properties": {
                "dst": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "end": {
                  "$ref": "#/$defs/EdgeEnd"
                },
                "src": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "src",
                "dst",
                "end"
              ],
              "type": "object"
            }
          },
          "required": [
            "unlink"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Add one edge end `src -> dst`.",
          "properties": {
            "link": {
              "properties": {
                "dst": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "end": {
                  "$ref": "#/$defs/EdgeEnd"
                },
                "src": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "src",
                "dst",
                "end"
              ],
              "type": "object"
            }
          },
          "required": [
            "link"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Replace a node's label, folded operands and the rest (never its origin).",
          "properties": {
            "relabel": {
              "properties": {
                "node": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "value": {
                  "$ref": "#/$defs/NNode"
                }
              },
              "required": [
                "node",
                "value"
              ],
              "type": "object"
            }
          },
          "required": [
            "relabel"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Remove a node without edges.",
          "properties": {
            "remove": {
              "properties": {
                "node": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "node"
              ],
              "type": "object"
            }
          },
          "required": [
            "remove"
          ],
          "type": "object"
        }
      ]
    },
    "Elem": {
      "description": "An element type. MLIR signless `iN` (N > 1) is a signed two's-complement integer in StableHLO\n(spec \"Types\": `si`/`i` are signed, `ui` unsigned); `i1` is the boolean.",
      "oneOf": [
        {
          "enum": [
            "bool"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "int": {
              "properties": {
                "signed": {
                  "type": "boolean"
                },
                "width": {
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "signed",
                "width"
              ],
              "type": "object"
            }
          },
          "required": [
            "int"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "float": {
              "properties": {
                "exp": {
                  "format": "uint8",
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                },
                "flavour": {
                  "$ref": "#/$defs/FloatFlavour"
                },
                "mant": {
                  "format": "uint8",
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "exp",
                "mant",
                "flavour"
              ],
              "type": "object"
            }
          },
          "required": [
            "float"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "complex": {
              "$ref": "#/$defs/Elem"
            }
          },
          "required": [
            "complex"
          ],
          "type": "object"
        }
      ]
    },
    "Family": {
      "description": "An element-type family (design §6.1): the part of a type in a component's identity.",
      "oneOf": [
        {
          "enum": [
            "bool",
            "sint",
            "uint",
            "float"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "complex": {
              "$ref": "#/$defs/Family"
            }
          },
          "required": [
            "complex"
          ],
          "type": "object"
        }
      ]
    },
    "FloatFlavour": {
      "description": "Special-value convention of a binary float format.",
      "oneOf": [
        {
          "const": "ieee",
          "description": "IEEE 754 style: infinities and NaNs.",
          "type": "string"
        },
        {
          "const": "finite_nan",
          "description": "`FN`: finite, NaN only, no infinities (OCP OFP8 E4M3, MLIR `f8E4M3FN`).",
          "type": "string"
        },
        {
          "const": "finite_nan_unsigned_zero",
          "description": "`FNUZ`: finite, one NaN encoding (negative zero), no infinities (MLIR `f8E4M3FNUZ`, `f8E5M2FNUZ`).",
          "type": "string"
        },
        {
          "const": "finite_nan_unsigned",
          "description": "`FNU`: finite, NaN only, unsigned (MLIR `f8E8M0FNU`).",
          "type": "string"
        },
        {
          "const": "finite_nan_unsigned_zero_bias11",
          "description": "`FN` with exponent bias 11 (MLIR `f8E4M3B11FNUZ`).",
          "type": "string"
        }
      ]
    },
    "GatherDims": {
      "description": "`stablehlo.gather` dimension numbers (spec `#gather`).",
      "properties": {
        "collapsed_slice_dims": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "index_vector_dim": {
          "format": "int64",
          "type": "integer"
        },
        "offset_dims": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "operand_batching_dims": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "start_index_map": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        },
        "start_indices_batching_dims": {
          "items": {
            "format": "int64",
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "offset_dims",
        "collapsed_slice_dims",
        "operand_batching_dims",
        "start_indices_batching_dims",
        "start_index_map",
        "index_vector_dim"
      ],
      "type": "object"
    },
    "Kind": {
      "description": "What a node is.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Argument `k` (dimension arguments not counted) of a decomposition; `None` for an external value\nof an anon region (unordered).",
          "properties": {
            "input": {
              "properties": {
                "index": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "type": "object"
            }
          },
          "required": [
            "input"
          ],
          "type": "object"
        },
        {
          "const": "output",
          "description": "A value of an anon region used outside it.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Argument `index` of region `region` of the owner op.",
          "properties": {
            "region_arg": {
              "properties": {
                "index": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "region": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "region",
                "index"
              ],
              "type": "object"
            }
          },
          "required": [
            "region_arg"
          ],
          "type": "object"
        },
        {
          "const": "size_in",
          "description": "A dimension value entering compute.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "op": {
              "properties": {
                "name": {
                  "type": "string"
                },
                "target": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            }
          },
          "required": [
            "op"
          ],
          "type": "object"
        }
      ]
