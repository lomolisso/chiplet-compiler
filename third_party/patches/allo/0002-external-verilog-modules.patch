+@needs_xls
+def test_extern_module_instantiated_by_codegen():
+    """An Allo kernel calling an external f32 multiplier: xlscc keeps the call,
+    opt_main keeps the invoke, codegen instantiates DW_fp_mult in a pipeline."""
+    s = allo.customize(unit)
+    with tempfile.TemporaryDirectory() as tmp:
+        s.build(target="xls", project=tmp)
+        ir = xlscc(tmp, "--top=unit")
+        assert "ffi_proto" in ir and "delay_ps: 800" in ir
+        top = top_name(ir)
+        opt = run(["opt_main", "unit.ir", f"--top={top}"], tmp)
+        assert "invoke(" in opt
+        with open(os.path.join(tmp, "unit.opt.ir"), "w", encoding="utf-8") as f:
+            f.write(opt)
+        run(
+            [
+                "codegen_main",
+                "unit.opt.ir",
+                "--generator=pipeline",
+                "--delay_model=asap7",
+                "--clock_period_ps=1000",
+                "--module_name=unit",
+                "--use_system_verilog=false",
+                "--output_verilog_path=unit.v",
+                "--output_signature_path=unit.sig.textproto",
+            ],
+            tmp,
+        )
+        with open(os.path.join(tmp, "unit.v"), encoding="utf-8") as f:
+            verilog = f.read()
+        with open(os.path.join(tmp, "unit.sig.textproto"), encoding="utf-8") as f:
+            sig = f.read()
+    assert re.search(r"^\s*DW_fp_mult #\(\.sig_width\(23\).*_inst \(", verilog, re.M)
+    assert "endmodule" in verilog
+    latency = int(re.search(r"latency: (\d+)", sig).group(1))
+    assert latency >= 2  # 800 ps of the 1000 ps clock: the xor goes in a later stage
