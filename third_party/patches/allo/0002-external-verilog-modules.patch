+void allo::hls::XlsModuleEmitter::emitExternVerilogAttribute(
+    func::FuncOp func) {
+  // Template placeholders follow XLS's foreign function interface: {fn} is
+  // the instance name, {return} the result, and {<name>} an argument, named
+  // as in the Allo source ("extern_arg_names"). The C++ argument names may
+  // differ (the emitter makes names unique), so placeholders are rewritten.
+  std::string tmpl =
+      llvm::cast<StringAttr>(func->getAttr("extern_verilog")).getValue().str();
+  std::string itypes;
+  if (auto attr = func->getAttrOfType<StringAttr>("itypes"))
+    itypes = attr.getValue().str();
+  SmallVector<std::string, 4> sourceNames;
+  if (auto names = func->getAttrOfType<ArrayAttr>("extern_arg_names"))
+    for (auto name : names)
+      sourceNames.push_back(llvm::cast<StringAttr>(name).getValue().str());
+  if (sourceNames.size() != func.getNumArguments()) {
+    emitError(func, "extern_arg_names must name every argument");
+    return;
+  }
+  DenseMap<StringRef, std::string> cxxNames;
+  for (auto [idx, arg] : llvm::enumerate(func.getArguments())) {
+    Value value = arg;
+    fixUnsignedType(value, idx < itypes.size() && itypes[idx] == 'u');
+    cxxNames[sourceNames[idx]] =
+        addName(value, /*isPtr=*/false, sourceNames[idx]).str().str();
+  }
+
+  std::string rewritten;
+  for (size_t pos = 0; pos < tmpl.size();) {
+    size_t open = tmpl.find('{', pos);
+    if (open == std::string::npos) {
+      rewritten += tmpl.substr(pos);
+      break;
+    }
+    size_t close = tmpl.find('}', open);
+    if (close == std::string::npos) {
+      emitError(func, "unterminated placeholder in the extern_verilog template");
+      return;
+    }
+    std::string key = tmpl.substr(open + 1, close - open - 1);
+    rewritten += tmpl.substr(pos, open - pos);
+    auto found = cxxNames.find(key);
+    if (found != cxxNames.end()) {
+      rewritten += "{" + found->second + "}";
+    } else if (key == "fn" || key == "return" || key.rfind("return.", 0) == 0) {
+      rewritten += "{" + key + "}";
+    } else {
+      emitError(func, "the extern_verilog template refers to {" + key +
+                          "}, which is not an argument");
+      return;
+    }
+    pos = close + 1;
+  }
+
+  os << "[[xlscc::extern_verilog(\"";
+  for (char c : rewritten) {
+    if (c == '\\' || c == '"')
+      os << '\\' << c;
+    else if (c == '\n')
+      os << "\\n";
+    else
+      os << c;
+  }
+  os << "\"";
+  if (auto delay = func->getAttrOfType<IntegerAttr>("extern_delay_ps"))
+    os << ", " << delay.getValue().getSExtValue();
+  os << ")]]\n";
+}
