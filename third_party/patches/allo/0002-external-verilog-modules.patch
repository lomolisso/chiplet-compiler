+def test_extern_declaration_errors():
+    with pytest.raises(ValueError, match="unknown placeholder"):
+
+        @allo.extern_verilog("m {fn} (.a({q}), .z({return}))")
+        def f1(a: uint32) -> uint32:
+            return a
+
+    with pytest.raises(ValueError, match="{fn}"):
+
+        @allo.extern_verilog("m inst (.a({a}), .z({return}))")
+        def f2(a: uint32) -> uint32:
+            return a
+
+    with pytest.raises(ValueError, match="either a template or a module"):
+        allo.extern_verilog()
+
+    with pytest.raises(ValueError, match="delay_ps"):
+
+        @allo.extern_verilog("m {fn} (.a({a}), .z({return}))", delay_ps=-1)
+        def f3(a: uint32) -> uint32:
+            return a
