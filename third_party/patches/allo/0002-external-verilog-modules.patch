+def _declare_extern_models(module):
+    """Replace every external Verilog module that has a simulation model by a
+    declaration, to be bound to the model with `register_runtime`.
+
+    Returns (name, spec, argument (width, signed) pairs, result width) tuples.
+    """
+    # pylint: disable=import-outside-toplevel
+    from .._mlir.dialects import func as func_d
+    from .._mlir.ir import (
+        FunctionType,
+        InsertionPoint,
+        IntegerType,
+        StringAttr,
+    )
+    from ..extern import lookup
+
+    found = []
+    for op in list(module.body.operations):
+        if not isinstance(op, func_d.FuncOp) or "extern_model" not in op.attributes:
+            continue
+        spec = lookup(StringAttr(op.attributes["extern_model"]).value)
+        if spec is None or spec.model is None:
+            continue  # simulate the body
+        ftype = FunctionType(op.type)
+        ins, outs = list(ftype.inputs), list(ftype.results)
+        if len(outs) != 1 or not all(
+            IntegerType.isinstance(t) and IntegerType(t).width <= 64
+            for t in ins + outs
+        ):
+            raise RuntimeError(
+                f"extern_verilog({spec.name}): a simulation model needs integer "
+                "arguments and one integer result of at most 64 bits"
+            )
+        itypes = (
+            StringAttr(op.attributes["itypes"]).value
+            if "itypes" in op.attributes
+            else "_" * len(ins)
+        )
+        args = [(IntegerType(t).width, h != "u") for t, h in zip(ins, itypes)]
+        name = StringAttr(op.attributes["sym_name"]).value
+        op.operation.erase()
+        decl = func_d.FuncOp(name=name, type=ftype, ip=InsertionPoint(module.body))
+        decl.attributes["sym_visibility"] = StringAttr.get("private")
+        decl.attributes["llvm.emit_c_interface"] = UnitAttr.get()
+        found.append((name, spec, args, IntegerType(outs[0]).width))
+    return found
+
+
+def _model_callback(spec, args, result_width, errors):
+    """A C callback that runs `spec.model` on the raw argument values."""
+
+    def ctype(width):
+        return {8: ctypes.c_uint8, 16: ctypes.c_uint16, 32: ctypes.c_uint32}.get(
+            max(get_clostest_pow2(width), 8), ctypes.c_uint64
+        )
+
+    def call(*raw):
+        try:
+            values = []
+            for value, (width, signed) in zip(raw, args):
+                value = int(value) & ((1 << width) - 1)
+                if signed and value >> (width - 1):
+                    value -= 1 << width
+                values.append(value)
+            return int(spec.model(*values)) & ((1 << result_width) - 1)
+        except Exception as e:  # pylint: disable=broad-exception-caught
+            errors.append(e)
+            return 0
+
+    proto = ctypes.CFUNCTYPE(ctype(result_width), *[ctype(w) for w, _ in args])
+    return proto(call)
+
