+# Copyright Allo authors. All Rights Reserved.
+# SPDX-License-Identifier: Apache-2.0
+"""External Verilog modules.
+
+A function decorated with :func:`extern_verilog` is implemented in hardware by
+an existing Verilog module (for example a floating-point IP core) instead of
+its body. Allo keeps the function as a separate callee:
+
+* ``target="xls"`` emits it with the xlscc attribute
+  ``[[xlscc::extern_verilog("<template>", <delay>)]]``, so XLS codegen
+  instantiates the module and schedules it as one combinational block of the
+  given delay. XLS supports combinational modules only.
+* ``target="llvm"`` simulates it with ``model`` (a Python callable on the raw
+  argument values, e.g. a NumPy model of the core); without a model, the body
+  is simulated.
+
+The body must still be valid Allo: xlscc translates it, and XLS IR evaluation
+uses it as the module's behaviour.
+
+The instantiation template uses XLS's foreign function syntax: ``{fn}`` is
+the instance name, ``{return}`` the result and ``{<arg>}`` an argument, by
+its name in the Python signature. Instead of a template, the module can be
+given as a name, parameters and a port map.
+"""
+
+import inspect
+import itertools
+import re
+
+_PLACEHOLDER = re.compile(r"\{([^{}]*)\}")
+_RESULT = re.compile(r"return(\.\d+)*")
+_REGISTRY = {}
+_COUNTER = itertools.count()
+
+
+class ExternVerilog:
+    """A Verilog module that implements an Allo function (see the module doc)."""
+
+    def __init__(self, fn, template, delay_ps=None, model=None):
+        self.name = fn.__name__
+        self.arg_names = list(inspect.signature(fn).parameters)
+        self.template = template
+        self.delay_ps = delay_ps
+        self.model = model
+        self.key = f"{fn.__qualname__}#{next(_COUNTER)}"
+        self._check()
+        _REGISTRY[self.key] = self
+
+    def _check(self):
+        if not isinstance(self.template, str) or "{fn}" not in self.template:
+            raise ValueError(
+                f"extern_verilog({self.name}): the template must contain {{fn}}, "
+                "the instance name"
+            )
+        for key in _PLACEHOLDER.findall(self.template):
+            if key != "fn" and key not in self.arg_names and not _RESULT.fullmatch(key):
+                raise ValueError(
+                    f"extern_verilog({self.name}): unknown placeholder {{{key}}}; "
+                    f"use {{fn}}, {{return}} or an argument of {self.arg_names}"
+                )
+        if self.delay_ps is not None and (
+            not isinstance(self.delay_ps, int) or not 0 <= self.delay_ps < 2**31
+        ):
+            raise ValueError(
+                f"extern_verilog({self.name}): delay_ps must be an integer >= 0"
+            )
+        if self.model is not None and not callable(self.model):
+            raise ValueError(f"extern_verilog({self.name}): model must be callable")
+
+    def attach(self, func_op):
+        """Record the declaration on the callee's ``func.func`` operation."""
+        # pylint: disable=import-outside-toplevel, no-name-in-module
+        from ._mlir.ir import ArrayAttr, IntegerAttr, IntegerType, StringAttr
+
+        func_op.attributes["extern_verilog"] = StringAttr.get(self.template)
+        func_op.attributes["extern_arg_names"] = ArrayAttr.get(
+            [StringAttr.get(name) for name in self.arg_names]
+        )
+        func_op.attributes["extern_model"] = StringAttr.get(self.key)
+        if self.delay_ps is not None:
+            func_op.attributes["extern_delay_ps"] = IntegerAttr.get(
+                IntegerType.get_signless(64), self.delay_ps
+            )
+
+
+def port_template(module, ports, params=None):
+    """An instantiation template from a module name, parameters and a port map.
+
+    ``ports`` maps each Verilog port to an argument name or ``"return"`` (the
+    result; any identifier is taken as one of these), a Verilog constant
+    expression (e.g. ``"3'b000"``), or ``None`` (left unconnected).
+    ``params`` maps parameter names to values.
+    """
+    text = module
+    if params:
+        text += " #(" + ", ".join(f".{k}({v})" for k, v in params.items()) + ")"
+    conns = []
+    for port, source in ports.items():
+        if source is None:
+            conns.append(f".{port}()")
+        elif re.fullmatch(r"[A-Za-z_]\w*(\.\d+)*", source):
+            # An identifier: an argument or the result.
+            conns.append(f".{port}({{{source}}})")
+        else:
+            conns.append(f".{port}({source})")
+    return text + " {fn} (" + ", ".join(conns) + ")"
+
+
+def extern_verilog(
+    template=None, *, module=None, params=None, ports=None, delay_ps=None, model=None
+):
+    """Declare that a function is implemented by an external Verilog module.
+
+    Either ``template`` (XLS foreign function syntax) or ``module`` with
+    ``ports`` (and optionally ``params``) gives the instantiation. ``delay_ps``
+    is the module's combinational delay for the XLS scheduler (codegen's
+    ``--ffi_fallback_delay_ps`` applies when it is omitted). ``model`` is the
+    simulation model for ``target="llvm"``: called with one Python int per
+    argument (unsigned arguments in ``[0, 2**width)``, signed ones as signed
+    values), it returns the result's bit pattern as an int.
+    """
+    if (template is None) == (module is None):
+        raise ValueError("extern_verilog: give either a template or a module")
+    if module is not None:
+        if ports is None:
+            raise ValueError("extern_verilog: a module needs its port map")
+        template = port_template(module, ports, params)
+
+    def decorate(fn):
+        fn.__allo_extern__ = ExternVerilog(fn, template, delay_ps, model)
+        return fn
+
+    return decorate
+
+
+def lookup(key):
+    """The declaration recorded under ``key`` (the ``extern_model`` attribute)."""
+    return _REGISTRY.get(key)
