+
+
+# ---------------------------------------------------------------------------
+# Partitioning
+# ---------------------------------------------------------------------------
+def acc(a: int32[4]) -> int32[4]:
+    r: int32[4] = 0
+    for i in allo.grid(4, name="acc"):
+        r[i] = a[i] + a[3 - i]
+    return r
+
+
+def test_complete_partition_is_a_tuple():
+    s = allo.customize(acc)
+    s.partition(s.r)
+    with tempfile.TemporaryDirectory() as tmp:
+        cpp = s.build(target="xls", project=tmp).final_cpp
+        decl = [l for l in cpp.splitlines() if re.search(r"\br\[4\]", l)]
+        assert decl and 'annotate_type("hls_array_as_tuple")' in decl[0], cpp
+        # Loops that index the tuple are unrolled (constant indices).
+        assert "#pragma hls_pipeline_init_interval 1\n" not in cpp.split("r[4]")[1].split(
+            "out.write"
+        )[0]
+        if HAS_XLS:
+            xlscc(tmp, "--block_from_class=TestBlock", "--block_pb=block.pb")
+
+
+def test_partial_partition_is_recorded():
+    s = allo.customize(acc)
+    s.partition(s.r, partition_type=allo.Partition.Cyclic, factor=2)
+    with tempfile.TemporaryDirectory() as tmp:
+        cpp = s.build(target="xls", project=tmp).final_cpp
+    assert "no xlscc equivalent" in cpp
+    assert "hls_array_as_tuple" not in cpp
+    assert "#pragma HLS" not in cpp
+
+
+def test_partitioned_array_is_not_a_memory():
+    s = allo.customize(gemm)
+    s.partition(s.C)
+    with tempfile.TemporaryDirectory() as tmp:
+        mod = s.build(target="xls", project=tmp, use_memory=True)
+    assert "hls_array_as_tuple" in mod.core_code
+    assert not re.search(r"__xls_memory_decl__: \w+, 16, C\b", mod.core_code)
