 static bool USE_MEMORY_FLAG = false;
 
+/// True if the memref is completely partitioned in every dimension
+/// (`partition` with the complete type, or a factor equal to each dimension).
+/// Such an array is a set of registers: xlscc keeps it as a tuple
+/// (`hls_array_as_tuple`), never as a memory.
+static bool isCompletelyPartitioned(Type type) {
+  auto memref = llvm::dyn_cast<MemRefType>(type);
+  return memref && memref.getRank() > 0 && getLayoutMap(memref) &&
+         isFullyPartitioned(memref);
+}
+
+/// True if multi-dimensional accesses to this memref use one flattened index
+/// (memory mode, where arrays become `__xls_memory`).
+static bool usesFlattenedIndex(MemRefType memrefType) {
+  return USE_MEMORY_FLAG && memrefType.getRank() > 1 &&
+         !isCompletelyPartitioned(memrefType);
+}
+
+/// True if the region loads from or stores to a completely partitioned array.
+static bool accessesPartitionedArray(Region &region) {
+  bool found = false;
+  region.walk([&](Operation *op) {
+    Value memref;
+    if (auto load = dyn_cast<AffineLoadOp>(op))
+      memref = load.getMemRef();
+    else if (auto store = dyn_cast<AffineStoreOp>(op))
+      memref = store.getMemRef();
+    else if (auto load = dyn_cast<memref::LoadOp>(op))
+      memref = load.getMemRef();
+    else if (auto store = dyn_cast<memref::StoreOp>(op))
+      memref = store.getMemRef();
+    if (memref && isCompletelyPartitioned(memref.getType())) {
+      found = true;
+      return WalkResult::interrupt();
+    }
+    return WalkResult::advance();
+  });
+  return found;
+}
