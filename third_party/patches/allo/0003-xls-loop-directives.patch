+# ---------------------------------------------------------------------------
+# Schedule directives
+# ---------------------------------------------------------------------------
+def vadd(a: int32[8], b: int32[8]) -> int32[8]:
+    c: int32[8] = 0
+    for i in allo.grid(8, name="add"):
+        c[i] = a[i] + b[i]
+    return c
+
+
+def gemm(A: int8[4, 4], B: int8[4, 4]) -> int32[4, 4]:
+    C: int32[4, 4] = 0
+    for i, j in allo.grid(4, 4, name="C"):
+        for k in allo.reduction(4):
+            C[i, j] += A[i, k] * B[k, j]
+    return C
+
+
+def directive_lines(cpp, keyword):
+    return [l.strip() for l in cpp.splitlines() if keyword in l]
+
+
+def loop_pragmas(cpp):
+    """The pragma in front of each compute loop over i, j or k."""
+    lines = cpp.splitlines()
+    out = {}
+    for n, line in enumerate(lines):
+        m = re.match(r"\s*for \(int (\w+) = ", line)
+        if m and not m.group(1).startswith("_"):
+            out[m.group(1)] = lines[n - 1].strip()
+    return out
+
+
+def test_no_full_unroll_by_default():
+    with tempfile.TemporaryDirectory() as tmp:
+        cpp = allo.customize(vadd).build(target="xls", project=tmp).final_cpp
+    assert loop_pragmas(cpp)["i"] == "#pragma hls_pipeline_init_interval 1"
+
+
+def test_unroll_factor_passed_through():
+    s = allo.customize(vadd)
+    s.unroll("i", factor=2)
+    with tempfile.TemporaryDirectory() as tmp:
+        cpp = s.build(target="xls", project=tmp).final_cpp
+    assert loop_pragmas(cpp)["i"] == "#pragma hls_unroll 2"
+    s = allo.customize(vadd)
+    s.unroll("i")
+    with tempfile.TemporaryDirectory() as tmp:
+        cpp = s.build(target="xls", project=tmp).final_cpp
+    assert loop_pragmas(cpp)["i"] == "#pragma hls_unroll yes"
+
+
+def test_pipeline_interval_passed_through():
+    s = allo.customize(vadd)
+    s.pipeline("i", initiation_interval=2)
+    with tempfile.TemporaryDirectory() as tmp:
+        cpp = s.build(target="xls", project=tmp).final_cpp
+    assert loop_pragmas(cpp)["i"] == "#pragma hls_pipeline_init_interval 2"
+
+
+def test_pipelined_loop_unrolls_inner_loops():
+    s = allo.customize(gemm)
+    s.pipeline("j")
+    with tempfile.TemporaryDirectory() as tmp:
+        cpp = s.build(target="xls", project=tmp).final_cpp
+        pragmas = loop_pragmas(cpp)
+        assert pragmas["i"] == "#pragma hls_pipeline_init_interval 1"
+        assert pragmas["j"] == "#pragma hls_pipeline_init_interval 1"
+        assert pragmas["k"] == "#pragma hls_unroll yes"
+        if HAS_XLS:
+            xlscc(tmp, "--block_from_class=TestBlock", "--block_pb=block.pb")
+
+
+def bitcount(x: uint32) -> uint32:
+    n: uint32 = 0
+    for i in range(32):
+        n += (x >> i) & 1
+    return n
+
+
+def test_combinational_function_loops_unroll():
