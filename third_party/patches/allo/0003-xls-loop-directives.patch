+        assert directive_lines(cpp, "#pragma hls_unroll") == ["#pragma hls_unroll yes"]
+        assert not directive_lines(cpp, "hls_pipeline_init_interval")
+        if HAS_XLS:
+            xlscc(tmp, "--top=bitcount")
