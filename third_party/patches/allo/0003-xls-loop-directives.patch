+/// The pipeline directive of a loop, if any: its initiation interval.
+static std::optional<int64_t> getPipelineII(Operation *op) {
+  if (auto ii = getLoopDirective(op, "pipeline_ii"))
+    if (auto intAttr = llvm::dyn_cast<IntegerAttr>(ii))
+      return std::max<int64_t>(intAttr.getValue().getZExtValue(), 1);
+  if (op->hasAttr("allo.pipeline") || op->hasAttr("pipeline_ii"))
+    return 1;
+  return std::nullopt;
+}
+
+/// The unroll directive of a loop, if any: 0 means full unrolling.
+static std::optional<int64_t> getUnrollFactor(Operation *op) {
+  if (auto factor = getLoopDirective(op, "unroll"))
+    if (auto intAttr = llvm::dyn_cast<IntegerAttr>(factor))
+      return intAttr.getValue().getZExtValue();
+  return std::nullopt;
+}
