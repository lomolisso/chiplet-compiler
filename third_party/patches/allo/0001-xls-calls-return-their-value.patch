+# Copyright Allo authors. All Rights Reserved.
+# SPDX-License-Identifier: Apache-2.0
+# pylint: disable=invalid-name,unsupported-assignment-operation
+"""XLS backend: function calls. When xlscc, opt_main and codegen_main are on PATH, the
+emitted C++ is also translated to check that XLS accepts it."""
+
+import os
+import re
+import shutil
+import subprocess
+import tempfile
+
+import numpy as np
+import pytest
+
+import allo
+from allo.ir.types import int32
+
+HAS_XLS = all(shutil.which(t) for t in ("xlscc", "opt_main", "codegen_main"))
+needs_xls = pytest.mark.skipif(not HAS_XLS, reason="XLS tools not on PATH")
+
+def run(cmd, cwd):
+    proc = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, check=False)
+    assert proc.returncode == 0, f"{cmd[0]} failed:\n{proc.stdout}\n{proc.stderr}"
+    return proc.stdout
+
+
+def xlscc(project, *extra):
+    """Translate project/test_block.cpp with xlscc; returns the IR text."""
+    cmd = [
+        "xlscc",
+        "test_block.cpp",
+        "--out=unit.ir",
+        f"--defines={os.environ.get('XLSCC_DEFINES', '__SYNTHESIS__,__xlscc__')}",
+        f"--include_dirs={os.environ.get('XLSCC_INCLUDE_DIRS', '')}",
+        *extra,
+    ]
+    run(cmd, project)
+    with open(os.path.join(project, "unit.ir"), encoding="utf-8") as f:
+        return f.read()
+
+
+def top_name(ir):
+    return re.search(r"^top fn (\w+)\(", ir, re.M).group(1)
+
+
+# ---------------------------------------------------------------------------
+# Calls: the callee returns its value
+# ---------------------------------------------------------------------------
+def scale(x: int32) -> int32:
+    y: int32 = x * 3
+    return y
+
+
+def caller(a: int32, b: int32) -> int32:
+    c: int32 = scale(a) + b
+    return c
+
+
+def test_call_returns_value():
+    s = allo.customize(caller)
+    with tempfile.TemporaryDirectory() as tmp:
+        mod = s.build(target="xls", project=tmp)
+        cpp = mod.final_cpp
+        assert re.search(r"\w+ = scale\(\w+\);", cpp)
+        assert "&" not in cpp.split("scale(", 2)[2].split(";")[0]
+        assert '#include "xls_builtin.h"' not in cpp
+        if HAS_XLS:
+            ir = xlscc(tmp, "--top=caller")
+            assert re.search(r"invoke\(.*to_apply=\w*scale", ir)
+    assert s.build()(np.int32(4), np.int32(5)) == 17
