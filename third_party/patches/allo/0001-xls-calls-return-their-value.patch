+void allo::hls::XlsModuleEmitter::emitCall(func::CallOp op) {
+  // The callee is emitted as a C++ function that returns its (single, scalar)
+  // result, so the call is an expression; the Vitis emitter's pointer outputs
+  // do not match that signature.
+  for (auto operand : op.getOperands())
+    if (llvm::isa<ShapedType>(operand.getType())) {
+      emitError(op, "XLS [CC] backend: calls with array arguments are not "
+                    "supported; inline the callee");
+      return;
+    }
+  if (op.getNumResults() > 1 ||
+      (op.getNumResults() == 1 &&
+       llvm::isa<ShapedType>(op.getResult(0).getType()))) {
+    emitError(op, "XLS [CC] backend: a called function must return at most "
+                  "one scalar");
+    return;
+  }
+
+  indent();
+  if (op.getNumResults() == 1) {
+    Value result = op.getResult(0);
+    auto callee =
+        SymbolTable::lookupNearestSymbolFrom<func::FuncOp>(op, op.getCalleeAttr());
+    if (callee)
+      if (auto otypes = callee->getAttrOfType<StringAttr>("otypes"))
+        fixUnsignedType(result, otypes.getValue().starts_with("u"));
+    emitValue(result);
+    os << " = ";
+  }
+  os << op.getCallee() << "(";
+  for (auto [idx, arg] : llvm::enumerate(op.getOperands())) {
+    if (idx > 0)
+      os << ", ";
+    emitValue(arg);
+  }
+  os << ");";
+  emitInfoAndNewLine(op);
+}
