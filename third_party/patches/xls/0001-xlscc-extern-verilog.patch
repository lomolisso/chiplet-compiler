diff --git a/xls/contrib/xlscc/unit_tests/translator_extern_verilog_test.cc b/xls/contrib/xlscc/unit_tests/translator_extern_verilog_test.cc
new file mode 100644
index 0000000..b0f38e7
--- /dev/null
+++ b/xls/contrib/xlscc/unit_tests/translator_extern_verilog_test.cc
@@ -0,0 +1,178 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// Tests of the hls_extern_verilog attribute (external Verilog modules).
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+#include "gmock/gmock.h"
+#include "gtest/gtest.h"
+#include "absl/status/status.h"
+#include "absl/status/status_matchers.h"
+#include "absl/strings/match.h"
+#include "xls/common/status/matchers.h"
+#include "xls/contrib/xlscc/unit_tests/unit_test.h"
+#include "xls/ir/function.h"
+#include "xls/ir/function_base.h"
+#include "xls/ir/node.h"
+#include "xls/ir/nodes.h"
+#include "xls/ir/op.h"
+
+namespace xlscc {
+namespace {
+
+using ::absl_testing::StatusIs;
+using ::testing::HasSubstr;
+
+class TranslatorExternVerilogTest : public XlsccTestBase {
+ public:
+  // The IR function generated for the C++ function `name`.
+  const xls::Function* FindFunction(std::string_view name) {
+    for (const xls::FunctionBase* f : package_->GetFunctionBases()) {
+      if (f->IsFunction() && absl::StrContains(f->name(), name)) {
+        return f->AsFunctionOrDie();
+      }
+    }
+    return nullptr;
+  }
+
+  int64_t CountInvokesOf(std::string_view caller, const xls::Function* callee) {
+    const xls::Function* f = FindFunction(caller);
+    int64_t n = 0;
+    for (const xls::Node* node : f->nodes()) {
+      if (node->op() == xls::Op::kInvoke &&
+          node->As<xls::Invoke>()->to_apply() == callee) {
+        ++n;
+      }
+    }
+    return n;
+  }
+};
+
+TEST_F(TranslatorExternVerilogTest, AttachesTemplateAndDelay) {
+  const std::string content = R"(
+    [[xlscc::extern_verilog(
+        "fmul_core {fn} (.a({a}), .b({b}), .z({return}))", 800)]]
+    unsigned fmul(unsigned a, unsigned b) { return a ^ b; }
+
+    #pragma hls_top
+    unsigned my_package(unsigned x, unsigned y, unsigned z) {
+      return fmul(x, y) + fmul(y, z);
+    })";
+  XLS_ASSERT_OK(SourceToIr(content).status());
+
+  const xls::Function* fmul = FindFunction("fmul");
+  ASSERT_NE(fmul, nullptr);
+  ASSERT_TRUE(fmul->ForeignFunctionData().has_value());
+  EXPECT_EQ(fmul->ForeignFunctionData()->code_template(),
+            "fmul_core {fn} (.a({a}), .b({b}), .z({return}))");
+  EXPECT_TRUE(fmul->ForeignFunctionData()->has_delay_ps());
+  EXPECT_EQ(fmul->ForeignFunctionData()->delay_ps(), 800);
+  // The parameters keep their C++ names, so the template can refer to them.
+  ASSERT_EQ(fmul->params().size(), 2);
+  EXPECT_EQ(fmul->params()[0]->name(), "a");
+  EXPECT_EQ(fmul->params()[1]->name(), "b");
+  // Each call stays an invoke of the external function.
+  EXPECT_EQ(CountInvokesOf("my_package", fmul), 2);
+}
+
+TEST_F(TranslatorExternVerilogTest, DelayIsOptional) {
+  const std::string content = R"(
+    [[hls_extern_verilog("neg_core {fn} (.a({a}), .z({return}))")]]
+    int neg(int a) { return -a; }
+
+    #pragma hls_top
+    int my_package(int x) { return neg(x) + 1; })";
+  XLS_ASSERT_OK(SourceToIr(content).status());
+
+  const xls::Function* neg = FindFunction("neg");
+  ASSERT_NE(neg, nullptr);
+  ASSERT_TRUE(neg->ForeignFunctionData().has_value());
+  EXPECT_FALSE(neg->ForeignFunctionData()->has_delay_ps());
+}
+
+TEST_F(TranslatorExternVerilogTest, BodyIsTheSimulationModel) {
+  const std::string content = R"(
+    [[xlscc::extern_verilog("add_core {fn} (.a({a}), .b({b}), .z({return}))")]]
+    int add(int a, int b) { return a + b; }
+
+    #pragma hls_top
+    int my_package(int x, int y) { return add(x, y) * 2; })";
+  Run({{"x", 3}, {"y", 4}}, 14, content);
+}
+
+TEST_F(TranslatorExternVerilogTest, UnmarkedFunctionsHaveNoTemplate) {
+  const std::string content = R"(
+    int add(int a, int b) { return a + b; }
+
+    #pragma hls_top
+    int my_package(int x, int y) { return add(x, y); })";
+  XLS_ASSERT_OK(SourceToIr(content).status());
+  const xls::Function* add = FindFunction("add");
+  if (add != nullptr) {
+    EXPECT_FALSE(add->ForeignFunctionData().has_value());
+  }
+}
+
+TEST_F(TranslatorExternVerilogTest, RejectsTopFunction) {
+  const std::string content = R"(
+    #pragma hls_top
+    [[xlscc::extern_verilog("core {fn} (.a({a}), .z({return}))")]]
+    int my_package(int a) { return a; })";
+  EXPECT_THAT(SourceToIr(content).status(),
+              StatusIs(absl::StatusCode::kUnimplemented,
+                       HasSubstr("cannot be the top function")));
+}
+
+TEST_F(TranslatorExternVerilogTest, RejectsVoidFunction) {
+  const std::string content = R"(
+    [[xlscc::extern_verilog("core {fn} (.a({a}))")]]
+    void sink(int a) { (void)a; }
+
+    #pragma hls_top
+    int my_package(int x) {
+      sink(x);
+      return x;
+    })";
+  EXPECT_THAT(SourceToIr(content).status(),
+              StatusIs(absl::StatusCode::kUnimplemented,
+                       HasSubstr("must return exactly one value")));
+}
+
+TEST_F(TranslatorExternVerilogTest, RejectsReferenceOutputs) {
+  const std::string content = R"(
+    [[xlscc::extern_verilog("core {fn} (.a({a}), .z({return}))")]]
+    int twice(int& a) { a = a + 1; return a; }
+
+    #pragma hls_top
+    int my_package(int x) { return twice(x) + x; })";
+  EXPECT_THAT(SourceToIr(content).status(),
+              StatusIs(absl::StatusCode::kUnimplemented,
+                       HasSubstr("non-const reference parameters")));
+}
+
+TEST_F(TranslatorExternVerilogTest, RejectsMalformedTemplate) {
+  const std::string content = R"(
+    [[xlscc::extern_verilog("core {fn (.a({a}), .z({return}))")]]
+    int id(int a) { return a; }
+
+    #pragma hls_top
+    int my_package(int x) { return id(x); })";
+  EXPECT_THAT(SourceToIr(content).status(),
+              StatusIs(absl::StatusCode::kInvalidArgument,
+                       HasSubstr("Invalid hls_extern_verilog template")));
+}
+
+TEST_F(TranslatorExternVerilogTest, RejectsNonStringTemplate) {
+  const std::string content = R"(
+    [[xlscc::extern_verilog(42)]]
+    int id(int a) { return a; }
+
+    #pragma hls_top
+    int my_package(int x) { return id(x); })";
+  EXPECT_FALSE(SourceToIr(content).ok());
+}
