+absl::Status Translator::SetExternVerilog(GeneratedFunction& sf,
+                                          const clang::FunctionDecl* funcdecl,
+                                          const FunctionInProgress& header,
+                                          const xls::SourceInfo& loc) {
+  const clang::AnnotateAttr* annotation = nullptr;
+  for (const clang::AnnotateAttr* attr : GetClangAnnotations(*funcdecl)) {
+    if (attr->getAnnotation() == "hls_extern_verilog") {
+      annotation = attr;
+      break;
+    }
+  }
+  XLSCC_CHECK_NE(annotation, nullptr, loc);
+
+  // The external module replaces exactly one IR function whose parameters
+  // and return value are the module's ports: a plain function of its
+  // arguments, computing one value, with no side effects.
+  auto unsupported = [&](std::string_view why) {
+    return absl::UnimplementedError(
+        ErrorMessage(loc, "Function %s marked hls_extern_verilog %s",
+                     funcdecl->getQualifiedNameAsString(), why));
+  };
+  if (funcdecl == currently_generating_top_function_) {
+    return unsupported("cannot be the top function");
+  }
+  if (header.has_this_param) {
+    return unsupported("must be a free function or a static method");
+  }
+  if (sf.slices.size() != 1 || !sf.io_ops.empty()) {
+    return unsupported("must not use channels or other IO");
+  }
+  if (!header.ref_returns.empty() || !sf.static_values.empty()) {
+    return unsupported(
+        "must not have non-const reference parameters or static variables");
+  }
+  if (funcdecl->getReturnType()->isVoidType() || sf.return_value_count != 1) {
+    return unsupported("must return exactly one value");
+  }
+  for (const GeneratedParamInfo& param_info : sf.param_infos) {
+    if (!param_info.has_func_param) {
+      return unsupported("must take only value parameters");
+    }
+  }
+
+  const auto* code_template = clang::dyn_cast<clang::StringLiteral>(
+      (*annotation->args_begin())->IgnoreParenCasts());
+  XLSCC_CHECK_NE(code_template, nullptr, loc);
+  absl::StatusOr<xls::ForeignFunctionData> ffi =
+      xls::ForeignFunctionDataCreateFromTemplate(code_template->getString());
+  if (!ffi.ok()) {
+    return absl::InvalidArgumentError(ErrorMessage(
+        loc, "Invalid hls_extern_verilog template for %s: %s",
+        funcdecl->getQualifiedNameAsString(), ffi.status().message()));
+  }
+  if (annotation->args_size() == 2) {
+    clang::Expr::EvalResult delay;
+    const clang::Expr* delay_expr = *(annotation->args_begin() + 1);
+    if (!delay_expr->EvaluateAsInt(delay, funcdecl->getASTContext()) ||
+        delay.Val.getInt().isNegative() ||
+        !delay.Val.getInt().isSignedIntN(32)) {
+      return absl::InvalidArgumentError(ErrorMessage(
+          loc, "hls_extern_verilog delay for %s must be an integer >= 0",
+          funcdecl->getQualifiedNameAsString()));
+    }
+    ffi->set_delay_ps(static_cast<int32_t>(delay.Val.getInt().getExtValue()));
+  }
+
+  xls::Function* function = sf.slices.front().function;
+  XLSCC_CHECK_NE(function, nullptr, loc);
+  function->SetForeignFunctionData(*ffi);
+  return absl::OkStatus();
+}
