+struct XlsExternVerilogAttrInfo : public clang::ParsedAttrInfo {
+  XlsExternVerilogAttrInfo() {
+    // GNU-style __attribute__((hls_extern_verilog("..."))) and C++/C23-style
+    // [[hls_extern_verilog("...")]], [[xlscc::hls_extern_verilog("...")]] and
+    // [[xlscc::extern_verilog("...")]] supported.
+    static constexpr Spelling S[] = {
+        {clang::ParsedAttr::AS_GNU, "hls_extern_verilog"},
+        {clang::ParsedAttr::AS_C23, "hls_extern_verilog"},
+        {clang::ParsedAttr::AS_CXX11, "hls_extern_verilog"},
+        {clang::ParsedAttr::AS_CXX11, "xlscc::hls_extern_verilog"},
+        {clang::ParsedAttr::AS_CXX11, "xlscc::extern_verilog"}};
+    Spellings = S;
+    // The instantiation template, then optionally the delay in picoseconds.
+    NumArgs = 1;
+    OptArgs = 1;
+  }
+
+  bool diagAppertainsToDecl(clang::Sema& S, const clang::ParsedAttr& Attr,
+                            const clang::Decl* D) const override {
+    // This attribute appertains to functions only.
+    if (!isa<clang::FunctionDecl>(D)) {
+      S.Diag(Attr.getLoc(), clang::diag::warn_attribute_wrong_decl_type_str)
+          << Attr << Attr.isRegularKeywordAttribute() << "functions";
+      return false;
+    }
+    return true;
+  }
+
+  AttrHandling handleDeclAttribute(
+      clang::Sema& S, clang::Decl* D,
+      const clang::ParsedAttr& Attr) const override {
+    auto invalid_argument = [&](const char* message) {
+      unsigned ID = S.getDiagnostics().getCustomDiagID(
+          clang::DiagnosticsEngine::Error, "%0");
+      S.Diag(Attr.getLoc(), ID) << message;
+      return AttributeNotApplied;
+    };
+    if (Attr.getNumArgs() < 1 || Attr.getNumArgs() > 2) {
+      return invalid_argument(
+          "'hls_extern_verilog' takes a template string and an optional delay "
+          "in picoseconds");
+    }
+    if (!Attr.isArgExpr(0) ||
+        !clang::isa<clang::StringLiteral>(
+            Attr.getArgAsExpr(0)->IgnoreParenCasts())) {
+      return invalid_argument(
+          "the first argument to 'hls_extern_verilog' must be a string "
+          "literal (the Verilog instantiation template)");
+    }
+    clang::Expr* args[2] = {Attr.getArgAsExpr(0), nullptr};
+    if (Attr.getNumArgs() == 2) {
+      args[1] = Attr.isArgExpr(1) ? Attr.getArgAsExpr(1) : nullptr;
+      if (args[1] == nullptr || !args[1]->isIntegerConstantExpr(S.Context) ||
+          args[1]->EvaluateKnownConstInt(S.Context).isNegative() ||
+          !args[1]->EvaluateKnownConstInt(S.Context).isSignedIntN(32)) {
+        return invalid_argument(
+            "the second argument to 'hls_extern_verilog' must be an integer "
+            ">= 0 (the delay in picoseconds)");
+      }
+    }
+    D->addAttr(clang::AnnotateAttr::Create(S.Context, "hls_extern_verilog",
+                                           args, Attr.getNumArgs(),
+                                           Attr.getRange()));
+    return AttributeApplied;
+  }
+};
+
+static clang::ParsedAttrInfoRegistry::Add<XlsExternVerilogAttrInfo>
+    hls_extern_verilog(
+        "hls_extern_verilog",
+        "Marks a function as implemented by an external Verilog module, "
+        "instantiated from a template; the C++ body is its simulation model.");
