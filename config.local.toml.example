# Copy to config.local.toml (untracked) and adjust. Values here override config.toml.
# Three machines share this NFS home (iacoma227, iacoma231, iacoma232). Every build, container, chipc run and test
# runs on the build host chosen with `scripts/on-build-host --pick`, through scripts/on-build-host, so the paths
# below are on that host's local disk (docs/development.md, "Build host and scratch").
# scripts/on-build-host sets CARGO_TARGET_DIR, the uv venv and TMPDIR under /scratch/$USER/chiplet-compiler.
# EDA, PDK and /software paths were verified on 2026-10-30 and are the same on both machines.

[paths]
eda_toggle = "/home/rid2/bin/eda-toggle.sh"      # defines eda-run; never source eda-on in the driver
pdk_root = "/home/rid2/pdks"                    # each kit's manifest root (pdks/<kit>.toml) is under it
# pdks = { asap7 = "/elsewhere/asap7sc7p5t_28" }  # a kit's root directly, when it is not under pdk_root
scratch_dir = "/scratch/rid2/chiplet-compiler"    # build area on the build host; tmp/ = EDA temp
smt_cache = "/scratch/rid2/chiplet-compiler/smt-cache"   # solver answers shared by every build dir
build_dir = "/scratch/rid2/chiplet-compiler/build"  # pass artifacts on the build host's local disk, not the NFS home
                                                     # (a worktree gets its own: scripts/build-area init <name>)
synopsys_root = "/software/Synopsys-2024_x86_64"
cadence_root = "/software/cadence-2024-08"

# config.toml admits passes within 128 GB and 32 threads ([resources]). On a host with less headroom (check
# `free -g` and the load), lower them here, for example:
# [resources]
# memory_budget_gb = 64
# threads_total = 16

