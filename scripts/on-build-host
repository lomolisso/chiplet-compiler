#!/usr/bin/env bash
# Run a command on the build host, in this checkout, with the project's build environment.
#
# Every compile, image build, container, chipc run and test runs on the build host chosen for the piece of work:
# over ssh, or directly when the build host is the machine this runs on. The NFS home is shared, so the checkout
# path is the same everywhere. Build outputs live in the build host's local scratch (docs/development.md, "Build
# host and scratch").
#
#   scripts/on-build-host --status                        cores, load, memory, free scratch and build-area state
#                                                         of every candidate host, with its headroom score
#   scripts/on-build-host --pick                          print the ready candidate with the most headroom
#                                                         (exit 1 if none)
#   scripts/on-build-host cargo build -p cc-cli
#   scripts/on-build-host cargo nextest run --profile smoke
#   scripts/on-build-host chipc run --only export         (chipc = the built binary, on PATH there)
#   scripts/on-build-host uv run --frozen python -m pytest python/tests -q
#   scripts/on-build-host docker/build.sh
#
# Environment: CC_BUILD_HOST (default iacoma231), CC_BUILD_HOSTS (candidates for --status and --pick, default
# "iacoma227 iacoma231 iacoma232"), CC_BUILD_AREA (default /scratch/$USER/chiplet-compiler), CC_PICK_THREADS and
# CC_PICK_MEMORY_GB (what the run needs, for --pick: default 16 threads, 32 GB).
set -euo pipefail

host="${CC_BUILD_HOST:-iacoma231}"
area="${CC_BUILD_AREA:-/scratch/$USER/chiplet-compiler}"
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ $# -eq 0 ]]; then
  sed -n '2,22p' "$0" >&2
  exit 2
fi

# Run a shell script (stdin) on host $1: directly on this machine, over ssh elsewhere. The local shell starts
# from an empty environment, like the ssh one.
on() {
  local h="$1"
  shift
  if [[ "${h%%.*}" == "$(hostname -s)" ]]; then
    env -i HOME="$HOME" USER="$USER" LANG="${LANG:-C.UTF-8}" bash --noprofile --norc -s "$@"
  else
    ssh -o BatchMode=yes -o ConnectTimeout=10 "$h" bash --noprofile --norc -s "$@"
  fi
}

# One line per host: name, cores, 1-minute load, available RAM (GB), free scratch (GB; the smaller of /scratch
# and Docker's root when they are different disks), build area (yes/no), toolchain image (yes/no).
# "unreachable" when the host cannot be reached.
probe() {
  on "$1" <<EOF 2>/dev/null || echo "$1 unreachable"
free_gb() { df -Pk "\$1" 2>/dev/null | awk 'NR == 2 {printf "%d", \$4 / 1048576}'; }
s=\$(free_gb /scratch)
root=\$(docker info -f '{{.DockerRootDir}}' 2>/dev/null || true)
if [ -n "\$root" ]; then d=\$(free_gb "\$root"); [ -n "\$d" ] && [ "\$d" -lt "\$s" ] && s=\$d; fi
echo \$(hostname -s) \$(nproc) \$(cut -d' ' -f1 /proc/loadavg) \
  \$(awk '/MemAvailable/ {printf "%d", \$2 / 1048576}' /proc/meminfo) \$s \
  \$([ -d '$area/target' ] && echo yes || echo no) \
  \$([ -n "\$(docker images -q chiplet-compiler/toolchain 2>/dev/null)" ] && echo yes || echo no)
EOF
}

if [[ "$1" == "--status" || "$1" == "--pick" ]]; then
  need_threads="${CC_PICK_THREADS:-16}"
  need_mem="${CC_PICK_MEMORY_GB:-32}"
  need_disk=150
  best="" best_score=-1
  printf '%-12s %5s %6s %5s %7s %10s %10s %6s %6s  %s\n' \
    host cores load idle ram_gb scratch_gb build_area image score verdict >&2
  for h in ${CC_BUILD_HOSTS:-iacoma227 iacoma231 iacoma232}; do
    read -r name cores load mem free area_ok image_ok <<<"$(probe "$h")"
    if [[ "$cores" == unreachable ]]; then
      printf '%-12s %s\n' "$h" unreachable >&2
      continue
    fi
    # Headroom: the scarcest of idle cores, available RAM and free disk, each relative to what the run needs
    # (RAM with 64 GB left for the machine's other users). At least 1 means every resource suffices.
    read -r idle score <<<"$(awk -v c="$cores" -v l="$load" -v m="$mem" -v f="$free" \
      -v nt="$need_threads" -v nm="$need_mem" -v nd="$need_disk" 'BEGIN {
        i = c - l; if (i < 0) i = 0
        s = i / nt; r = m / (nm + 64); if (r < s) s = r; d = f / nd; if (d < s) s = d
        printf "%d %.2f", i, s }')"
    why=()
    awk -v l="$load" -v c="$cores" 'BEGIN {exit !(l >= 0.5 * c)}' && why+=("load >= half the cores")
    (( idle < need_threads )) && why+=("idle cores < $need_threads")
    (( mem < need_mem + 64 )) && why+=("RAM < ${need_mem}+64 GB")
    (( free < need_disk )) && why+=("scratch < $need_disk GB")
    [[ "$area_ok" == yes ]] || why+=("no build area")
    [[ "$image_ok" == yes ]] || why+=("no image")
    if (( ${#why[@]} == 0 )); then
      verdict=ok
      if awk -v a="$score" -v b="$best_score" 'BEGIN {exit !(a > b)}'; then best="$h" best_score="$score"; fi
    else
      verdict="skip: ${why[0]}"
      for w in "${why[@]:1}"; do verdict+=", $w"; done
    fi
    printf '%-12s %5s %6s %5s %7s %10s %10s %6s %6s  %s\n' \
      "$h" "$cores" "$load" "$idle" "$mem" "$free" "$area_ok" "$image_ok" "$score" "$verdict" >&2
  done
  if [[ "$1" == "--pick" ]]; then
    [[ -n "$best" ]] || { echo "on-build-host: no candidate passes the thresholds" >&2; exit 1; }
    echo "$best"
  fi
  exit 0
fi

cmd="$(printf '%q ' "$@")"
# A non-login, non-interactive shell with an explicit environment: no profile noise, nothing implicit.
on "$host" <<EOF
set -euo pipefail
export HOME='$HOME' USER='$USER'
export PATH='$area/target/debug:$HOME/.cargo/bin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin'
export CARGO_TARGET_DIR='$area/target'
export UV_PROJECT_ENVIRONMENT='$area/venv'
export TMPDIR='$area/tmp'
export CC_BUILD_AREA='$area'
export JAX_PLATFORMS=cpu KERAS_BACKEND=jax
mkdir -p '$area'/{target,venv,build,logs,runs,tmp}
cd '$repo'
$cmd
EOF
